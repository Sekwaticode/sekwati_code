# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used to create client portal logins. NEVER prefix this with NEXT_PUBLIC_.
# Project Settings -> API Keys -> Secret keys (sb_secret_...). The legacy "service_role" key also works.
SUPABASE_SECRET_KEY=sb_secret_xxx
